# contoh: salin jadi .env di Coolify (Environment Variables)
PORT=8080
DATABASE_URL=postgres://prasasti:CHANGE_ME@postgres:5432/prasasti
JWT_SECRET=CHANGE_ME_min_32_karakter_acak
# utk migrasi awal saja; kosongkan setelah DB siap
RUN_MIGRATIONS=true
# S3 Onidel (wajib utk upload surat dokter & foto profil)
S3_ENDPOINT=https://s3.ap-southeast-1.onidel.cloud
S3_BUCKET=NAMA_BUCKET
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=ISI_DI_COOLIFY
S3_SECRET_KEY=ISI_DI_COOLIFY
# false = virtual-hosted (bucket.endpoint); true = path-style (endpoint/bucket)
S3_PATH_STYLE=false
# true = avatar bisa dibuka via URL publik
S3_AVATAR_PUBLIC=true
# Push FCM HTTP v1 (opsional; kosong = push mati, notifikasi in-app saja).
# FCM_SERVICE_ACCOUNT = isi file JSON service account Firebase (satu baris).
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=
# Batas laju endpoint publik: daftar 10/jam/IP, cek username 30/mnt/IP,
# login 30/mnt/IP, lupa-password 20/mnt/IP (diperketat di kode bila perlu).
